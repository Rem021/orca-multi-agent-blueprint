# ==============================================================================
# Orca Multi-Agent Blueprint — configuration
#
# `./deploy.sh --auto` writes `config.env` (git-ignored) from what it detects; you rarely need this file.
# To set something by hand, copy a line into `config.env`, remove the `#`, change the value and run
# `./deploy.sh --apply`. Every line below shows the built-in default.
# Use plain KEY="value" lines: no `${...}` defaults and no commands. `$HOME` is fine.
# ==============================================================================

# ── 1. Where the workspace lives ──────────────────────────────────────────────
# "auto"     external drive if one already has an AI/ folder, otherwise the internal disk
# "external" everything under /Volumes/<drive>/AI (mount + volume-UUID check before every write)
# "internal" everything under INTERNAL_WORKSPACE_PATH/AI
# STORAGE_MODE="auto"
# AI_VOLUME_PATH="/Volumes/AI_Workspace"
# INTERNAL_WORKSPACE_PATH="$HOME/AI-Workspace"
# UUID the external drive must have. "AUTO" accepts the drive that is mounted at AI_VOLUME_PATH;
# internal mode records "LOCAL".
# AI_VOLUME_UUID="AUTO"

# ── 2. Who hands out the work ─────────────────────────────────────────────────
# Optional personal assistant that acts as the supervisor: it takes your request, splits it into
# tasks and dispatches them to the coding agents through the Orca CLI.
# "none" (default): you talk to the coding agents directly.
# Any other value is the assistant's name (for example "orca-mobile", "claude-desktop" or the name of
# your own assistant). It is written into the global rules so workers know where tasks come from and
# where to report back. `./deploy.sh --auto` asks once when run in a terminal.
# SUPERVISOR_AGENT="none"

# Language of the generated global rules (~/.codex/AGENTS.md, ~/.claude/CLAUDE.md, ~/.gemini/GEMINI.md):
# "en" or "zh-CN". `--auto` picks zh-CN when the macOS locale is Chinese.
# RULES_LANGUAGE="en"

# Coding agents that receive skills, rules and hooks. Empty: every agent installed on this Mac.
# `--auto` fills in the agents it finds; list fewer to leave the others alone.
# WORKER_AGENTS=""

# Prefix for task branches and worktrees, e.g. "codex/fix-login" or "claude/fix-login".
# DEFAULT_BRANCH_PREFIX="codex"

# ── 3. Xcode MCP and shared iOS simulators ───────────────────────────────────
# ENABLE_XCODE_MCP="true"
# XCODE_MCP_STARTUP_TIMEOUT_SEC="120"
# XCODE_MCP_TOOL_TIMEOUT_SEC="600"
# Two long-lived simulators shared by agents (detected by --auto, never garbage-collected).
# Leave empty if you only use disposable simulators from `agent-test-device`.
# PRIMARY_SIMULATOR_UDID=""
# PRIMARY_SIMULATOR_NAME=""
# SECONDARY_SIMULATOR_UDID=""
# SECONDARY_SIMULATOR_NAME=""

# ── 4. Tools and guardrails ──────────────────────────────────────────────────
# Install rg, fd, ast-grep, just, xcbeautify, restic and gh into ~/.local/bin.
# INSTALL_CLI_TOOLCHAIN="true"
# feature.manyFiles, rerere, relative worktree paths, branch sorting.
# ENABLE_GIT_ACCELERATION="true"
# Register agent-guard as the pre-command hook of every agent.
# ENABLE_PRETOOLUSE_GUARDRAILS="true"
# Run `agent-governor` cleanup when a Claude Code session ends (scheduled cleanup runs either way).
# ENABLE_SESSION_HYGIENE="true"
# Branches agents may never force-push or delete on a remote (space-separated globs).
# GUARD_PROTECTED_BRANCHES="main master"
# Branches agents may never push at all, e.g. local history that still contains secrets
# (space-separated globs, "none" = no restriction).
# GUARD_RESTRICTED_BRANCHES="none"

# ── 5. Scheduled backups (LaunchAgents) ──────────────────────────────────────
# volume-guard (60 s / 10 min), backup-hot (hourly), icloud-package (02:30), backup-projects (03:00),
# backup-media (Sun 04:00), maintenance (Sun 05:30), restore-drill (Sun 07:00), agent-hygiene (hourly).
# ENABLE_AUTOMATED_BACKUPS="true"
# Folder in iCloud Drive for the nightly encrypted package.
# BACKUP_ICLOUD_DIR="$HOME/Library/Mobile Documents/com~apple~CloudDocs/Agent Backups/Nightly"
# Restic repository: a local folder or a folder on a NAS share.
# Default: <workspace>/AI/Backups/restic (a local repository inside the workspace).
# BACKUP_RESTIC_REPO="/Volumes/Backup/restic-mac-agents"
# NAS share holding the Restic repository: its mount point and a substring of its `mount` line,
# e.g. BACKUP_NAS_MOUNT="/Volumes/Backup" and BACKUP_NAS_SMB_MATCH="/Backup on /Volumes/Backup (smbfs,".
# BACKUP_NAS_MOUNT=""
# BACKUP_NAS_SMB_MATCH=""
# "auto": mount silently when the NAS answers and its password is in the Keychain
# "always": always try (macOS may show a login dialog) · "never": skip until mounted by hand
# BACKUP_NAS_AUTOMOUNT="auto"
# Large folder backed up weekly with a bandwidth cap (empty = no media backup).
# BACKUP_MEDIA_PATH=""
# Name of this Mac in snapshots and package names. Empty = derived from LocalHostName; a tag inherited
# from another Mac through migration is replaced unless BACKUP_HOST_TAG_KEEP="true".
# BACKUP_HOST_TAG=""
# BACKUP_HOST_TAG_KEEP="false"
# iCloud retention: newest N confirmed-uploaded packages per Mac, plus optional age limit for extras.
# BACKUP_ICLOUD_KEEP_LATEST="1"
# BACKUP_ICLOUD_MAX_AGE_DAYS="7"
# "all-hosts": prune every Mac's old packages (never another Mac's newest) · "self": this Mac only
# BACKUP_ICLOUD_PRUNE_SCOPE="all-hosts"
# Retire another Mac's last package after N idle days (0 = keep forever).
# BACKUP_ICLOUD_STALE_HOST_DAYS="0"
# How often agent-hygiene re-runs iCloud pruning (pending uploads are polled every 30 min regardless).
# BACKUP_ICLOUD_PRUNE_INTERVAL_SEC="3600"
# How long weekly maintenance waits for other jobs to release the Restic lock.
# BACKUP_MAINTENANCE_RETRY_LOCK="30m"
# Hours without a successful hourly backup before "skipped" becomes a "stale" alert (0 disables).
# Daily jobs use 3x and weekly jobs 14x this value.
# BACKUP_STALE_ALERT_HOURS="24"
# "off" silences desktop notifications from the backup jobs.
# BACKUP_NOTIFY="on"

# ── 6. Moving to a new Mac (--pack-to-ssd / --restore-from-ssd) ──────────────
# Agent state, LaunchAgents and their Application Support folders, SQLite databases and Keychain items
# are found automatically. Comma-separated additions:
# Paths under $HOME added to the migration snapshot and to the nightly iCloud package.
# EXTRA_MIGRATION_PATHS=""
# Paths under $HOME added to Restic and the migration snapshot only (large working folders).
# EXTRA_RESTIC_PATHS=""
# Extra .app bundles from /Applications to copy onto the drive, e.g. "Ghostty.app,Tailscale.app".
# EXTRA_BUNDLED_APPS=""
# Extra Keychain generic-password services to export and import.
# EXTRA_KEYCHAIN_SERVICES=""
