# ==============================================================================
# Orca Multi-Agent Blueprint — Parameterized Configuration (config.env)
# Copy to `config.env` and customize, or let `./deploy.sh --auto` generate it!
# ==============================================================================

# 1. Dual-Mode Storage Topology (External SSD vs. Internal Disk)
# Options:
#   "auto"     -> Uses external SSD under /Volumes/* if detected, otherwise falls back to internal disk
#   "external" -> Stores all AI Projects, Worktrees, Archives & Caches on an external SSD (with UUID & USB guard)
#   "internal" -> Stores all AI Projects, Worktrees, Archives & Caches on the Mac's internal disk (INTERNAL_WORKSPACE_PATH)
STORAGE_MODE="${STORAGE_MODE:-auto}"

# Workspace root when STORAGE_MODE="external" (e.g. /Volumes/AI_Workspace) or active root
AI_VOLUME_PATH="${AI_VOLUME_PATH:-/Volumes/AI_Workspace}"

# Workspace root when STORAGE_MODE="internal" (default: $HOME/AI-Workspace)
INTERNAL_WORKSPACE_PATH="${INTERNAL_WORKSPACE_PATH:-$HOME/AI-Workspace}"

# Optional: Enforce hardware Volume UUID check before any write to an external AI_VOLUME_PATH.
# Leave empty ("") or "AUTO" to auto-detect on external volumes. Internal mode has no volume to verify and
# records the value as "LOCAL".
AI_VOLUME_UUID="AUTO"

# 2. Pluggable Tier-1 Supervisor (Front-End Commander)
# Options: "muse" | "orca-mobile" | "claude-desktop" | "openclaw" | "custom"
SUPERVISOR_AGENT="muse"

# Optional Tailscale / Relay endpoint for remote Supervisor -> Mac Orca CLI
ORCA_RELAY_HOST="127.0.0.1"
ORCA_RELAY_PORT="6768"

# 3. Pluggable Tier-3 Worker Agent Fleet (Comma-separated)
# Supported: claude, codex, antigravity, dsh, opencode, cursor, aider
WORKER_AGENTS="claude,codex,antigravity,dsh"

# 4. Git & Naming Conventions
# Default branch prefix for new task worktrees (e.g. codex, claude, feat)
DEFAULT_BRANCH_PREFIX="codex"

# Project alias mapping (JSON object mapping legacy names to canonical display names)
PROJECT_ALIASES_JSON='{"NovaRAW":"NovaCam","NovaCam Pro":"NovaCam","FlowEngine":"流织","FlowWeave":"流织","Infra_v2":"CloudNode","Game":"星际前线","ORCA":"Mac","Orca":"Mac"}'

# 5. Apple / Xcode MCP & iOS Simulator Lease Coordination
ENABLE_XCODE_MCP="true"
XCODE_MCP_STARTUP_TIMEOUT_SEC="120"
XCODE_MCP_TOOL_TIMEOUT_SEC="600"

# Designated reusable iOS Simulators (auto-detected by `./deploy.sh --auto`)
PRIMARY_SIMULATOR_UDID="11111111-2222-3333-4444-555555555555"
PRIMARY_SIMULATOR_NAME="iPhone 18 Pro Max (iOS 27.0)"
SECONDARY_SIMULATOR_UDID="66666666-7777-8888-9999-AAAAAAAAAAAA"
SECONDARY_SIMULATOR_NAME="iPhone 18 Pro Max - Secondary (iOS 27.0)"

# 6. CLI Toolchain Installation & Safety Guardrails
# Installs native arm64/x64 binaries (rg, fd, ast-grep, just, xcbeautify, scc, repomix) into ~/.local/bin
INSTALL_CLI_TOOLCHAIN="true"
ENABLE_GIT_ACCELERATION="true"
ENABLE_PRETOOLUSE_GUARDRAILS="true"
# Branches the guard never lets an agent force-push or delete on the remote (space-separated globs)
GUARD_PROTECTED_BRANCHES="${GUARD_PROTECTED_BRANCHES:-main master}"
# Branches the guard never lets an agent push at all, e.g. local history that contains secrets.
# Set to "none" if your team pushes `develop` normally.
GUARD_RESTRICTED_BRANCHES="${GUARD_RESTRICTED_BRANCHES:-develop feat/C-*}"

# 7. Automated Multi-Tier Backup & Storage Watchdog Suite (LaunchAgents)
# Installs and schedules:
#   - Nightly 02:30 Encrypted iCloud Compact Package (AES-256-CBC + APFS CoW SQLite snapshots + auto brctl evict)
#   - Hourly Restic Hot Backup (all internal-disk AI agent states, memories & profiles)
#   - Daily 03:00 Restic Projects Backup (${AI_VOLUME_PATH}/AI/Projects, Archive & Data)
#   - Weekly Sunday 04:00 Restic Media Backup (BACKUP_MEDIA_PATH, bandwidth-capped)
#   - Weekly Sunday 05:30 Retention Prune & Integrity Check + Sunday 07:00 Restore Verification Drill
#   - 60-Second External Volume UUID & USB Re-enumeration Watchdog (active in external SSD mode)
ENABLE_AUTOMATED_BACKUPS="${ENABLE_AUTOMATED_BACKUPS:-true}"
BACKUP_ICLOUD_DIR="${BACKUP_ICLOUD_DIR:-$HOME/Library/Mobile Documents/com~apple~CloudDocs/AI备份/每晚小包}"
BACKUP_RESTIC_REPO="${BACKUP_RESTIC_REPO:-${AI_VOLUME_PATH}/AI/Backups/restic}"
BACKUP_NAS_MOUNT="${BACKUP_NAS_MOUNT:-}"
BACKUP_NAS_SMB_MATCH="${BACKUP_NAS_SMB_MATCH:-}"
BACKUP_MEDIA_PATH="${BACKUP_MEDIA_PATH:-}"
# Name of this Mac in Restic snapshots and iCloud package file names. Leave empty: it is derived from the
# Mac's LocalHostName, and a tag inherited from another Mac through a migration snapshot is replaced
# automatically. Set BACKUP_HOST_TAG_KEEP="true" only if a new Mac should continue the old Mac's history.
BACKUP_HOST_TAG="${BACKUP_HOST_TAG:-}"
BACKUP_HOST_TAG_KEEP="${BACKUP_HOST_TAG_KEEP:-false}"
# How many of this Mac's nightly iCloud packages to keep (older ones are deleted after each upload)
BACKUP_ICLOUD_KEEP_LATEST="${BACKUP_ICLOUD_KEEP_LATEST:-1}"
# When the Restic repo lives on an SMB share that is not mounted:
#   "auto"   -> mount it silently, but only if the NAS answers and its password is saved in the Keychain
#   "always" -> always try to mount (macOS may show a login dialog every hour)
#   "never"  -> never mount; skip the job until the share is mounted by hand
BACKUP_NAS_AUTOMOUNT="${BACKUP_NAS_AUTOMOUNT:-auto}"
# Hours without a successful hourly backup before "skipped" turns into a "stale" alert (0 disables).
# Daily jobs use 3x and weekly jobs 14x this value.
BACKUP_STALE_ALERT_HOURS="${BACKUP_STALE_ALERT_HOURS:-24}"
# "off" silences desktop notifications from the backup jobs
BACKUP_NOTIFY="${BACKUP_NOTIFY:-on}"

# 8. Cross-Mac Lossless SSD Migration (--pack-to-ssd / --restore-from-ssd)
# Note: LaunchAgents and their referenced ~/Library/Application Support/* folders, SQLite DBs,
# and Keychain services are auto-discovered dynamically. You can also specify extras below:
# Optional comma-separated additional relative paths under $HOME to include when packing to SSD
EXTRA_MIGRATION_PATHS="${EXTRA_MIGRATION_PATHS:-}"
# Optional comma-separated additional .app names in /Applications to bundle onto the SSD
EXTRA_BUNDLED_APPS="${EXTRA_BUNDLED_APPS:-}"
# Optional comma-separated macOS Keychain generic-password service names to export/import
EXTRA_KEYCHAIN_SERVICES="${EXTRA_KEYCHAIN_SERVICES:-}"
