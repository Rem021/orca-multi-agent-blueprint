# ==============================================================================
# Orca Multi-Agent Blueprint — Parameterized Configuration (config.env)
# Copy to `config.env` and customize, or let `./deploy.sh --auto` generate it!
# ==============================================================================

# 1. Storage & External Volume Boundary
# Set AI_VOLUME_PATH to your dedicated external SSD (e.g. /Volumes/AI_Workspace)
# or a local workspace root (e.g. "$HOME/AI-Workspace").
AI_VOLUME_PATH="${AI_VOLUME_PATH:-/Volumes/AI_Workspace}"

# Optional: Enforce hardware Volume UUID check before any write to AI_VOLUME_PATH.
# Leave empty ("") or "AUTO" to auto-detect on external volumes.
AI_VOLUME_UUID="AUTO"

# 2. Pluggable Tier-1 Supervisor (Front-End Commander)
# Options: "muse" | "orca-mobile" | "claude-desktop" | "openclaw" | "custom"
SUPERVISOR_AGENT="muse"

# Optional Tailscale / Relay endpoint for remote Supervisor -> Mac Orca CLI
ORCA_RELAY_HOST="127.0.0.1"
ORCA_RELAY_PORT="6768"

# 3. Pluggable Tier-3 Worker Agent Fleet (Comma-separated)
# Supported: claude, codex, antigravity, dsh, opencode, cursor, aider
WORKER_AGENTS="claude,codex,antigravity,dsh"

# 4. Git & Naming Conventions
# Default branch prefix for new task worktrees (e.g. codex, claude, feat)
DEFAULT_BRANCH_PREFIX="codex"

# Project alias mapping (JSON object mapping legacy names to canonical display names)
PROJECT_ALIASES_JSON='{"NovaRAW":"NovaCam","NovaCam Pro":"NovaCam","FlowEngine":"流织","FlowWeave":"流织","Infra_v2":"CloudNode","Game":"星际前线","ORCA":"Mac","Orca":"Mac"}'

# 5. Apple / Xcode MCP & iOS Simulator Lease Coordination
ENABLE_XCODE_MCP="true"
XCODE_MCP_STARTUP_TIMEOUT_SEC="120"
XCODE_MCP_TOOL_TIMEOUT_SEC="600"

# Designated reusable iOS Simulators (auto-detected by `./deploy.sh --auto`)
PRIMARY_SIMULATOR_UDID="11111111-2222-3333-4444-555555555555"
PRIMARY_SIMULATOR_NAME="iPhone 18 Pro Max (iOS 27.0)"
SECONDARY_SIMULATOR_UDID="66666666-7777-8888-9999-AAAAAAAAAAAA"
SECONDARY_SIMULATOR_NAME="iPhone 18 Pro Max - Secondary (iOS 27.0)"

# 6. CLI Toolchain Installation
# Installs native arm64/x64 binaries (rg, fd, ast-grep, just, xcbeautify, scc, repomix) into ~/.local/bin
INSTALL_CLI_TOOLCHAIN="true"
ENABLE_GIT_ACCELERATION="true"
ENABLE_PRETOOLUSE_GUARDRAILS="true"

# 7. Cross-Mac Lossless SSD Migration (--pack-to-ssd / --restore-from-ssd)
# Note: LaunchAgents and their referenced ~/Library/Application Support/* folders, SQLite DBs,
# and Keychain services are auto-discovered dynamically. You can also specify extras below:
# Optional comma-separated additional relative paths under $HOME to include when packing to SSD
EXTRA_MIGRATION_PATHS="${EXTRA_MIGRATION_PATHS:-}"
# Optional comma-separated additional .app names in /Applications to bundle onto the SSD
EXTRA_BUNDLED_APPS="${EXTRA_BUNDLED_APPS:-}"
# Optional comma-separated macOS Keychain generic-password service names to export/import
EXTRA_KEYCHAIN_SERVICES="${EXTRA_KEYCHAIN_SERVICES:-}"
