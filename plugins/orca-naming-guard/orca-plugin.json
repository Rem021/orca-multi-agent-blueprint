{
  "manifestVersion": 2,
  "execution": "trusted-worker",
  "id": "workspace-naming-guard",
  "name": "工作区中文命名",
  "version": "0.2.0",
  "description": "创建新工作区时保持空白且零 Git 扫描延迟；仅在向智能体发送任务后自动将工作区命名为「项目名｜具体主题」。不调用模型，不调度 Agent。",
  "engines": { "orca": ">=1.4.250" },
  "main": "worker.mjs",
  "capabilities": [{ "kind": "workspace:read" }, { "kind": "storage:own" }],
  "contributes": {
    "commands": [{ "id": "naming.preview", "title": "命名：检查待统一的工作区", "when": "global" }],
    "events": [{ "on": "workspace.created" }],
    "statusBarItems": [{ "id": "naming", "text": "中文命名", "icon": "edit", "command": "naming.preview", "tooltip": "仅修改 Orca 工作区显示名" }]
  }
}
